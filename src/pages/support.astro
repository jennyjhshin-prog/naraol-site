---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import { org } from '../lib/data';

const won = (n: number) => `${n.toLocaleString('ko-KR')}원`;
---
<Base title="함께하기" description="(사)나라얼연구소 회원 가입과 후원 안내">
  <PageTitle title="함께하기" lead="회원과 후원자의 회비는 상례문화 보존과 학술연구, 인문학강좌에 쓰입니다." />
  <div class="container prose">
    <h2 style="margin-top:0">회원과 회비</h2>
    <table class="info-table">
      <tbody>
        {org.dues.map((d) => <tr><th scope="row">{d.label}</th><td>월 {won(d.amount)}</td></tr>)}
      </tbody>
    </table>
    {org.donationDesignated && <p style="margin-top:1rem">{org.donationDesignated}</p>}

    <h2>후원 계좌</h2>
    <p class="account">
      <span class="bank">{org.bank.name}</span>
      <span class="no">{org.bank.account}</span>
      <span class="holder">예금주 {org.bank.holder}</span>
    </p>

    <h2>소식과 행사 신청</h2>
    <p>강좌·학술대회 일정과 신청, 자료는 다음카페에서 안내합니다.</p>
    <p class="no-print">
      {org.cafeUrl && <a class="button" href={org.cafeUrl} target="_blank" rel="noopener">다음카페 바로가기</a>}
      <a class="button" href={org.kakaoUrl} target="_blank" rel="noopener">카카오톡 문의</a>
      <a class="button" href={`tel:${org.phone}`}>전화 {org.phone}</a>
    </p>
  </div>
</Base>

<style>
  .account { display: flex; flex-wrap: wrap; gap: .3rem 1rem; align-items: baseline; border: 1px solid var(--line); background: var(--paper-deep); padding: 1rem 1.2rem; }
  .bank { font-weight: 600; }
  .no { font-family: var(--serif); font-weight: 700; color: var(--accent); font-size: 1.3rem; letter-spacing: .02em; }
  .holder { color: var(--ink-soft); }
</style>
