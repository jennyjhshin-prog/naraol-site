---
import { org } from '../lib/data';
import YouTubeLink from './YouTubeLink.astro';
const corp = [
  org.representative && `대표자 ${org.representative}`,
  org.regNo && `고유번호 ${org.regNo}`,
].filter(Boolean);
---
<footer class="site-footer">
  <div class="container">
    <p class="name">{org.name}</p>
    {corp.length > 0 && <p>{corp.join(' · ')}</p>}
    <p>주소 {org.address} · 전화 <a href={`tel:${org.phone}`}>{org.phone}</a></p>
    <p class="links">
      {org.cafeUrl && <a href={org.cafeUrl} target="_blank" rel="noopener">다음카페</a>}
      <YouTubeLink showName />
      <a href={org.kakaoUrl} target="_blank" rel="noopener">카카오톡 채널 문의</a>
      <a href="/about/info/">법인 정보·오시는 길</a>
    </p>
    <p class="copy">© {new Date().getFullYear()} {org.name}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink-deep); padding: 2.5rem 0 2.75rem; color: #B9AF9E; font-size: .92rem; border-top: 3px solid var(--gold); }
  .site-footer p { margin: 0 0 .3rem; }
  .site-footer a, .site-footer :global(.yt) { color: #D8CFBF; text-decoration-color: rgba(205, 181, 133, .4); }
  .site-footer a:hover, .site-footer :global(.yt:hover) { color: var(--gold-soft); }
  .name { font-family: var(--serif); font-weight: 700; color: #F4EEE2; font-size: 1.1rem; margin-bottom: .7rem !important; }
  .links { display: flex; flex-wrap: wrap; gap: .3rem 1rem; }
  .copy { margin-top: .8rem !important; font-size: .85rem; }
</style>
