---
import { org } from '../lib/data';

interface Props {
  /** 아이콘 옆에 채널 이름을 함께 보일지 */
  showName?: boolean;
  class?: string;
}
const { showName = false, class: className } = Astro.props;
const name = org.youtubeName ?? '유튜브';
const label = `${name} 유튜브 채널 (새 창)`;
---
{org.youtubeUrl && (
  <a class:list={['yt', className]} href={org.youtubeUrl} target="_blank" rel="noopener" aria-label={showName ? undefined : label} title={label}>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" />
    </svg>
    {showName && <span>{name}</span>}
  </a>
)}

<style>
  .yt { display: inline-flex; align-items: center; gap: .35rem; color: var(--ink-soft); text-decoration: none; }
  .yt:hover { color: var(--ink); }
  .yt svg { flex: none; }
</style>
