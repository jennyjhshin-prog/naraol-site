---
import type { Stat } from '../lib/stats';

interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---
{stats.length > 0 && (
  <div class="stats" style={`--n:${stats.length}`}>
    {stats.map((s) => (
      <div class="stat">
        <div><span class="stat-value">{s.value}</span>{s.unit && <span class="stat-unit">{s.unit}</span>}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>
)}
