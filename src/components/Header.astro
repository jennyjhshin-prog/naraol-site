---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { NAV } from '../lib/nav';
import { org } from '../lib/data';
import YouTubeLink from './YouTubeLink.astro';

const cafeUrl = org.cafeUrl;
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href.split('/').slice(0, 2).join('/') + '/');
---
<header class="site-header">
  <a class="skip" href="#main">본문 바로가기</a>
  <div class="container bar">
    <a class="brand" href="/">
      <Image src={logo} alt="" width={57} height={40} loading="eager" />
      <span>(사)나라얼연구소</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">메뉴</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" aria-label="주 메뉴">
      <ul class="menu">
        {NAV.map((item) => (
          <li class={item.children ? 'has-sub' : undefined}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            {item.children && (
              <ul class="sub">
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="ext">
        {cafeUrl && <a class="cafe" href={cafeUrl} target="_blank" rel="noopener">다음카페</a>}
        <YouTubeLink showName class="yt-head" />
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector('.menu-toggle');
    var nav = document.getElementById('site-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('open', !open);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && nav.classList.contains('open')) {
        btn.setAttribute('aria-expanded', 'false');
        nav.classList.remove('open');
        btn.focus();
      }
    });
  })();
</script>

<style>
  .site-header { border-top: 3px solid var(--ink-deep); border-bottom: 1px solid var(--line); background: var(--paper); position: relative; z-index: 10; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 8px; background: var(--ink); color: var(--paper); padding: .4rem .8rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 68px; }
  .brand { display: flex; align-items: center; gap: .6rem; text-decoration: none; font-family: var(--serif); font-weight: 700; font-size: 1.15rem; color: var(--ink); }
  .brand img { height: 40px; width: auto; }
  nav { display: flex; align-items: center; gap: 1.5rem; }
  .menu { list-style: none; margin: 0; padding: 0; display: flex; gap: .25rem; }
  .menu > li { position: relative; }
  .menu a { display: block; padding: .6rem .8rem; text-decoration: none; color: var(--ink); font-weight: 500; }
  .menu > li > a[aria-current='page'] { color: var(--accent); }
  .sub { list-style: none; margin: 0; padding: .4rem 0; position: absolute; left: 0; top: 100%; min-width: 13rem; background: var(--paper); border: 1px solid var(--line); display: none; }
  .sub a { padding: .45rem 1rem; font-weight: 400; }
  .sub a:hover { background: var(--paper-deep); }
  .has-sub:hover > .sub, .has-sub:focus-within > .sub { display: block; }
  .cafe { font-size: .88rem; color: var(--ink-soft); border: 1px solid var(--line); padding: .25rem .6rem; text-decoration: none; }
  .ext { display: flex; align-items: center; gap: .9rem; }
  @media (min-width: 768px) { .ext :global(.yt-head span) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } }
  .menu-toggle { display: none; }

  @media (max-width: 767px) {
    .menu-toggle { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; background: none; border: 1px solid var(--line); cursor: pointer; }
    .bars, .bars::before, .bars::after { display: block; width: 20px; height: 2px; background: var(--ink); position: relative; content: ''; }
    .bars::before { position: absolute; top: -6px; }
    .bars::after { position: absolute; top: 6px; }
    nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 1px solid var(--line); flex-direction: column; align-items: stretch; gap: 0; padding: .5rem 16px 1rem; }
    nav.open { display: flex; }
    .menu { flex-direction: column; }
    .menu a { padding: .55rem 0; }
    .sub { display: block; position: static; border: 0; padding: 0 0 .4rem 1rem; min-width: 0; background: none; }
    .sub a { padding: .3rem 0; color: var(--ink-soft); }
    .ext { margin-top: .5rem; }
  }
</style>
